{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and permissions on the platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["super_admin", "ministry_admin", "content_manager", "teacher", "moderator", "event_manager", "user"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },
    "DailyEncouragement": {
      "title": "DailyEncouragement",
      "description": "Daily words of encouragement and scripture messages for believers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 4000 },
        "scriptureRef": { "type": "string", "maxLength": 100 },
        "scriptureText": { "type": "string", "maxLength": 1000 },
        "theme": { "type": "string", "maxLength": 50 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorId": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "likesCount": { "type": "number" },
        "audioUrl": { "type": "string" },
        "pinned": { "type": "boolean" }
      },
      "required": ["id", "title", "message", "scriptureRef", "authorName", "date", "createdAt"]
    },
    "PrayerRequest": {
      "title": "PrayerRequest",
      "description": "Prayer requests in the prayer sanctuary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "description", "authorId", "createdAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Community posts including dreams, worries, and prayer requests with anonymous posting support and admin pastoral care visibility",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "isAnonymous": { "type": "boolean" },
        "anonymousSystemId": { "type": "string", "maxLength": 50 },
        "postType": { "type": "string", "enum": ["dream", "worry", "prayer_request"] },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "category": { "type": "string", "maxLength": 100 },
        "pleasePrayForMe": { "type": "boolean" },
        "prayedCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "authorId", "postType", "createdAt"]
    },
    "UserStudyProgress": {
      "title": "UserStudyProgress",
      "description": "User completion progress and active day for a Bible study plan",
      "type": "object",
      "properties": {
        "planId": { "type": "string" },
        "isEnrolled": { "type": "boolean" },
        "currentDay": { "type": "number" },
        "completedDays": { "type": "number" },
        "completedDayNumbers": { "type": "array", "items": { "type": "number" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["planId", "isEnrolled", "currentDay", "completedDays", "completedDayNumbers"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores individual user account profile and settings"
    },
    "/users/{userId}/studyProgress/{progressId}": {
      "schema": "UserStudyProgress",
      "description": "Tracks believer's completion percentage and completed days in a study plan"
    },
    "/encouragements/{encouragementId}": {
      "schema": "DailyEncouragement",
      "description": "Stores daily words of encouragement and text messages published for members"
    },
    "/prayers/{prayerId}": {
      "schema": "PrayerRequest",
      "description": "Stores community prayer requests"
    },
    "/communityPosts/{postId}": {
      "schema": "CommunityPost",
      "description": "Stores community posts (dreams, worries, prayer requests) with anonymous and identified support"
    }
  }
}
